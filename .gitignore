# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups (podem conter dados sensíveis — nunca versionar)
/backups

# dados reais de cadastro (CPF/CNPJ + senha em texto puro) — nunca versionar.
# Os .template.csv continuam versionados (são só exemplo, sem dado real).
/scripts/dados/*.csv
!/scripts/dados/*.template.csv

# material de estudo pessoal — não faz parte do produto
/material_estudo
/material_estudo.zip
